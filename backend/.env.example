# CyberGuard AI - example environment file.
# Copy to ".env" and adjust locally. Never commit the real .env file.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_for_local_development
DATABASE_URL=sqlite:///cyberguard.db
FRONTEND_URL=http://localhost:5173
HOST=127.0.0.1
PORT=5000

# Demo analyst account created by seed_database.py
DEMO_ADMIN_EMAIL=admin@cyberguard.ai
DEMO_ADMIN_PASSWORD=admin123

# Detection engine tuning (0.5 = relaxed, 1.0 = default, 1.5 = aggressive)
DETECTION_SENSITIVITY=1.0
TOKEN_MAX_AGE_SECONDS=86400
